<?xml version="1.0" standalone="yes"?>
<!-- 定年专用模板：Thorney + constant-size coalescent。
     与 skygrid/skyline 模板的区别是树先验换成单参数 constant-size。
     原因：skygrid 的 cutOff 把日历时标钉进了网格，会和节点校准抢绝对时间、把树拉年轻；
     constant-size 只有一个自由估计的 popSize，是尺度等变的（同时缩放所有节点时间与 popSize，
     coalescent 密度近似不变），因此不强加时标——绝对时间由节点校准 + clock 先验干净驱动。
     本步骤产出的是发表用的 TMRCA；人口史曲线另用 skygrid/skyline 步骤重建。 -->
<beast>
{taxa_xml}

{calibration_taxa_xml}

    <newick id="startingTree" usingDates="true">
        {starting_tree}
    </newick>

    <newick id="dataTree" usingDates="false" usingHeights="true">
        {data_tree}
    </newick>

    <constrainedTreeModel id="treeModel">
        <tree idref="startingTree"/>
        <constraintsTree>
            <tree idref="dataTree"/>
        </constraintsTree>
    </constrainedTreeModel>

    <simpleMutationBranchMap id="branchMutationCounts" scale="{scale}">
        <constrainedTreeModel idref="treeModel"/>
        <dataTree>
            <tree idref="dataTree"/>
        </dataTree>
    </simpleMutationBranchMap>

    <treeHeightStatistic id="treeModel.rootHeight">
        <treeModel idref="treeModel"/>
    </treeHeightStatistic>
    <treeLengthStatistic id="treeLength">
        <treeModel idref="treeModel"/>
    </treeLengthStatistic>
    {tmrca_stats}

    <constantSize id="constant" units="years">
        <populationSize>
            <parameter id="constant.popSize" value="{skyline_init_popsize}" lower="0.0"/>
        </populationSize>
    </constantSize>

    <coalescentLikelihood id="coalescent">
        <model>
            <constantSize idref="constant"/>
        </model>
        <populationTree>
            <treeModel idref="treeModel"/>
        </populationTree>
    </coalescentLikelihood>

    <strictClockBranchRates id="branchRates">
        <rate>
            <parameter id="clock.rate" value="{clock_rate}" lower="0.0"/>
        </rate>
    </strictClockBranchRates>

    <thorneyTreeLikelihood id="treeLikelihood">
        <constrainedTreeModel idref="treeModel"/>
        <simpleMutationBranchMap idref="branchMutationCounts"/>
        <strictClockBranchRates idref="branchRates"/>
        <poissonBranchLengthLikelihood id="branchMutationLikelihood" scale="{scale}"/>
    </thorneyTreeLikelihood>

    <operators id="operators" optimizationSchedule="default">
        <scaleOperator scaleFactor="0.75" weight="3">
            <parameter idref="clock.rate"/>
        </scaleOperator>
        <nodeHeightOperator type="uniform" weight="500">
            <treeModel idref="treeModel"/>
        </nodeHeightOperator>
        <nodeHeightOperator type="scaleRoot" weight="100" scaleFactor="0.75">
            <treeModel idref="treeModel"/>
        </nodeHeightOperator>
        <scaleOperator scaleFactor="0.75" weight="3">
            <parameter idref="constant.popSize"/>
        </scaleOperator>
    </operators>

    <mcmc id="mcmc" chainLength="{chain_length}" autoOptimize="true" operatorAnalysis="{output_prefix}.ops">
        <joint id="joint">
            <prior id="prior">
{normal_priors}
                <!-- clock.rate 的 informative 先验：必须与节点年龄先验自洽（见 conf yaml）。
                     constant-size 不抢时标，故钟先验可适度放宽，让节点校准主导。 -->
                <logNormalPrior id="clock.prior" mean="{clock_rate}" stdev="0.25" offset="0.0" meanInRealSpace="true">
                    <parameter idref="clock.rate"/>
                </logNormalPrior>
                <!-- popSize 的 Jeffreys (1/x) 无尺度先验：让 Ne 自由适配任意时标，
                     从而不向绝对时间注入信息。 -->
                <oneOnXPrior>
                    <parameter idref="constant.popSize"/>
                </oneOnXPrior>
                <coalescentLikelihood idref="coalescent"/>
            </prior>
            <likelihood id="likelihood">
                <thorneyTreeLikelihood idref="treeLikelihood"/>
            </likelihood>
        </joint>
        <operators idref="operators"/>
        <log id="screenLog" logEvery="{log_every}">
            <column label="Joint" dp="4" width="12"><joint idref="joint"/></column>
            <column label="Prior" dp="4" width="12"><prior idref="prior"/></column>
            <column label="Likelihood" dp="4" width="12"><likelihood idref="likelihood"/></column>
            <column label="age(root)" sf="6" width="12"><tmrcaStatistic idref="age(root)"/></column>
            <column label="clock.rate" sf="6" width="12"><parameter idref="clock.rate"/></column>
        </log>
        <log id="fileLog" logEvery="{log_every}" fileName="{output_prefix}.log" overwrite="false">
            <joint idref="joint"/>
            <prior idref="prior"/>
            <likelihood idref="likelihood"/>
            <treeHeightStatistic idref="treeModel.rootHeight"/>
            <tmrcaStatistic idref="age(root)"/>
            <tmrcaStatistic idref="age(M)"/>
            <tmrcaStatistic idref="age(N)"/>
            <treeLengthStatistic idref="treeLength"/>
            <parameter idref="clock.rate"/>
            <parameter idref="constant.popSize"/>
            <coalescentLikelihood idref="coalescent"/>
        </log>
        <logTree id="treeFileLog" logEvery="{tree_log_every}" nexusFormat="true" fileName="{output_prefix}.trees" sortTranslationTable="true">
            <treeModel idref="treeModel"/>
            <joint idref="joint"/>
        </logTree>
    </mcmc>

    <report>
        <property name="timer">
            <mcmc idref="mcmc"/>
        </property>
    </report>
</beast>
